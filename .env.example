# Copy to .env (optional). All values have safe defaults.
# NASA API key from https://api.nasa.gov/ (DEMO_KEY works but is rate-limited).
NASA_API_KEY=DEMO_KEY
# true = mission simulator available (demonstration). false = wait for real sensors via POST /api/v1/telemetry.
ORION_DEMO_MODE=true
# false = never call external NASA services (fully offline run).
ORION_EXTERNAL_FETCH=true
# Optional ground endpoint for the sync queue. Empty + demo mode = simulated loopback ground station.
ORION_GROUND_SYNC_URL=
# Crew Fitness Management System (optional module, see docs/CFMS.md). false = behaves as v1.0.3.
ORION_CFMS_ENABLED=false
# Optional overrides
# ORION_DB_PATH=backend/data/orion_med.db
# ORION_CONFIG_DIR=config
